{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run @AppleSupport Agent (main.py)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Run Interactive Agent CLI",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--interactive"],
            "console": "integratedTerminal"
        },
        {
            "name": "Run System Evaluation (evaluate.py)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/evaluate.py",
            "console": "integratedTerminal"
        }
    ]
}